# ── Vercel 환경변수 예시 ────────────────────────────────
# Vercel 대시보드 → Settings → Environment Variables 에 같은 이름으로 등록하세요.
# (.env 파일을 그대로 커밋하지 마세요. 실제 값은 Vercel/로컬에만 둡니다.)

# [필수] Google Apps Script 웹앱 URL (배포 → 웹 앱 → URL 복사)
GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbXXXXXXXXXXXXXXXX/exec

# [권장] Apps Script 스크립트 속성 SHARED_TOKEN 과 같은 값
# 설정하면 웹훅 호출 URL 에 ?token=... 이 붙어, URL 을 아는 제3자의 무단 호출을 막습니다.
WEBHOOK_SHARED_SECRET=

# [선택] IP 기준 접수 제한 (기본: 분당 3회 / 하루 20회)
RATE_LIMIT_PER_MINUTE=3
RATE_LIMIT_PER_DAY=20
